# ==============================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (SEM VALORES / SECRETS)
# Copie este arquivo para .env.local e preencha com as suas credenciais seguras.
# NUNCA commite o arquivo .env ou .env.local no controle de versão.
# ==============================================================================

# URL e chaves do Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Armazenamento de Fotos e Banners)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (Disparo de E-mails Transacionais e Contratos)
RESEND_API_KEY=

# Google Gemini API (IA Gratuita para legendas - Sem Billing ativado)
GEMINI_API_KEY=
GEMINI_MODEL=

# Segredo de Sessão e Criptografia (Gere strings aleatórias de 32+ caracteres)
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# URL Base da Aplicação em Produção (ex: https://seudominio.com.br)
NEXT_PUBLIC_APP_URL=

# Credenciais Super Admin (Plataforma)
ADMIN_USER=
ADMIN_PASS=
MFA_SUPER_ADMIN_SECRET=

# Credenciais Lojistas (Usadas na inicialização / migração para store_users)
LL_ADMIN_USER=
LL_ADMIN_PASS=
CAR_ADMIN_USER=
CAR_ADMIN_PASS=
